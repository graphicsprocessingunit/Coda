+#import <Foundation/Foundation.h>
+#import <AudioToolbox/AudioToolbox.h>
+#import <CoreMedia/CoreMedia.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+/**
+ * Five-band peaking EQ applied to the AVPlayer's post-effects audio tap.
+ * Settings are read from UserDefaults (written by the app's AudioEQ module),
+ * so the audio thread never crosses into JS.
+ */
+@interface AudioEQProcessor : NSObject
+
++ (instancetype)sharedProcessor;
+
+- (void)prepareWithSampleRate:(double)sampleRate;
+
+- (void)processBufferList:(AudioBufferList *)bufferList
+                   frames:(CMItemCount)frameCount
+           nonInterleaved:(BOOL)nonInterleaved;
+
+@end
+
+NS_ASSUME_NONNULL_END
